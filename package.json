{
  "name": "unicornline",
  "description": "Unicorn Line product catalog",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "upload:assets": "node --env-file=.env scripts/upload-assets.mjs",
    "build": "node src/build.mjs && node scripts/check-links.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "publish:images": "node --env-file=.env scripts/publish-images.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "parse:carton-sizes": "node scripts/parse-carton-sizes.mjs"
  },
  "devDependencies": {
    "aws4fetch": "^1.0.20",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  }
}
